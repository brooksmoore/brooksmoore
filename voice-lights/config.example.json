    },
    "focus": {
      "phrases": ["focus", "work", "work mode", "deep work"],
      "steps": [{ "device": "all", "brightness": 100, "temperature": "daylight" }]
    },
    "chill": {
      "phrases": ["chill", "relax", "wind down"],
      "steps": [
        { "device": "torch", "brightness": 25, "temperature": "warm" },
        { "device": "mushroom", "brightness": 20, "color": "purple" },
        { "device": "lamp", "power": false }
      ]
    }
  }
